{
  "name": "memvana-shot",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first screenshot intelligence for Claude.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "npm run build:native && npm run build:mcp",
    "build:native": "swift build -c release --package-path native",
    "build:mcp": "node scripts/bundle.mjs",
    "typecheck": "tsc -p mcp",
    "test": "node --disable-warning=ExperimentalWarning --test \"mcp/test/**/*.test.ts\"",
    "fixtures": "swift scripts/make-fixtures.swift mcp/test/fixtures/library"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
